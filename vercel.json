{
  "version": 2,
  "installCommand": "npm install && npm --prefix tee install && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/tee-api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/((?!api/|tee-api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
